<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NU1903: Microsoft.AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0, which
         carries GHSA-v5pm-xwqc-g5wc (DoS while *parsing* an untrusted OpenAPI document).
         This service only generates a document, never parses one, so the vulnerable code
         path is unreachable. Microsoft.OpenApi 3.x fixes it but is not yet compatible with
         the ASP.NET OpenAPI source generator - revisit when the framework package updates. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

</Project>
